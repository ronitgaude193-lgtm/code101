# ==========================================
# AI CODING MENTOR - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Core
APP_ENV=development
APP_SECRET_KEY=change-this-in-production-to-a-secure-random-key-dbce-mentor
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (REQUIRED) - Supabase PostgreSQL connection string.
# Supabase Dashboard -> Connect -> Connection string (URI).
# Example Session Pooler (IPv4 compatible):
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local LLM with Ollama (Active Default)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:latest

# Cloud AI Provider Integration (Optional: gemini, openai, or groq)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Code Execution Engine (Optional: Judge0 Hosted / Self-Hosted API)
JUDGE0_API_URL=
JUDGE0_API_KEY=
